{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "ui": { "label": "Notificaciones activas", "group": "Notificaciones" }
    },
    "idle_timeout_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 15,
      "ui": { "label": "Tiempo de inactividad (min)", "group": "Sesión", "hint": "5-120 minutos" }
    },
    "allow_concurrent_sessions": {
      "type": "boolean",
      "default": true,
      "ui": { "label": "Permitir sesiones concurrentes", "group": "Sesión" }
    },
    "theme_mode": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "default": "system",
      "ui": {
        "label": "Tema predeterminado",
        "group": "UI",
        "control": "select",
        "options": [
          { "value": "light", "label": "Claro" },
          { "value": "dark", "label": "Oscuro" },
          { "value": "system", "label": "Sistema" }
        ]
      }
    },
    "export_excel_enabled": {
      "type": "boolean",
      "default": true,
      "ui": { "label": "Permitir exportar Excel", "group": "Exportación" }
    },
    "default_page_size": {
      "type": "integer",
      "minimum": 10,
      "maximum": 100,
      "default": 25,
      "ui": { "label": "Registros por página", "group": "UI", "hint": "10-100" }
    }
  }
}
